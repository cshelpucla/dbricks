# Settings for the Bluesky ingestion pipeline. Edit, then re-run ./setup.sh to apply.

DATABRICKS_PROFILE=DEFAULT

# Unity Catalog location. The schema is created if missing.
CATALOG=datawranglers
SCHEMA=bluesky
BRONZE_TABLE=events_raw

# SQL warehouse used for DDL and status queries. Empty = first warehouse in the workspace.
WAREHOUSE_ID=

# Resource names, and the workspace folder (under your user home) the code is uploaded to.
JOB_NAME=bluesky-jetstream-ingest
PIPELINE_NAME=bluesky-silver
WORKSPACE_SUBDIR=bluesky

# Jetstream v2 hosts in failover order, and the collections to subscribe to.
JETSTREAM_HOSTS=jetstream.us-east.bsky.network,jetstream.us-west.bsky.network
COLLECTIONS=app.bsky.feed.post,app.bsky.feed.like,app.bsky.feed.repost,app.bsky.graph.follow

# Ingestion tuning: seconds between bronze writes, and how far to rewind the cursor on restart.
FLUSH_SECONDS=30
REWIND_SECONDS=10

# Silver pipeline mode: true = always on (seconds of latency), false = triggered (run on demand/schedule).
PIPELINE_CONTINUOUS=true

# Serverless job environment.
SERVERLESS_ENV_VERSION=3
WEBSOCKETS_VERSION=16.0

# Enrichment job (docs/ENRICHMENT_SPEC.md): bot filter, geo, embeddings, IPTC topics. Always on when enabled.
ENRICH_ENABLED=true
ENRICH_JOB_NAME=bluesky-enrich
ENRICH_WINDOW_SECONDS=120
ENRICH_INTERVAL_SECONDS=20
ENRICH_LAG_MARGIN_SECONDS=60
ENRICH_START_MINUTES=30
EMBED_ENDPOINT=databricks-qwen3-embedding-0-6b
# Embedding cap per window (600 per 120 s is about 5 posts/s, roughly 25M tokens a day). Raise once the cost is known.
EMBED_MAX_PER_WINDOW=600
TOPIC_MIN_SCORE=0.62
DATABRICKS_SDK_VERSION=0.169.0

# Topic map job: 2D layout + clusters + LLM cluster names, written to post_map and topic_clusters. Scheduled.
MAP_ENABLED=true
MAP_JOB_NAME=bluesky-topic-map
# Quartz cron, UTC: every 2 hours on the hour.
MAP_SCHEDULE="0 0 0/2 * * ?"
MAP_HOURS=24
MAP_MAX_POINTS=40000
MAP_LABEL_ENDPOINT=databricks-claude-haiku-5-5
# Taxonomy jobs: one scheduled job per entity list, pulled from Wikipedia/Wikidata into taxonomy_people and
# taxonomy_companies. The enrichment job picks up new data within 10 minutes. Quartz cron, UTC.
TAXONOMY_ENABLED=true
TAXONOMY_PEOPLE_JOB_NAME=bluesky-taxonomy-people
TAXONOMY_PEOPLE_SCHEDULE="0 0 3 ? * MON"
TAXONOMY_COMPANIES_JOB_NAME=bluesky-taxonomy-companies
TAXONOMY_COMPANIES_SCHEDULE="0 30 3 ? * MON"
# Wikimedia asks API clients to put a contact (URL or email) in the User-Agent; without one they rate-limit hard.
WIKI_CONTACT=

# Pinned to match serverless environment 3, which preinstalls numpy 1.26.4, scipy 1.13.1 and scikit-learn 1.4.2
# (core packages must not be upgraded). umap-learn 0.5.7 is the last release that works with scikit-learn < 1.6.
UMAP_VERSION=0.5.7
NUMBA_VERSION=0.60.0
PYNNDESCENT_VERSION=0.5.13
