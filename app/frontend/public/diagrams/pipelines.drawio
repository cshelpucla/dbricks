        <mxCell id="ovw-v8" value='&lt;b style="font-size:13px"&gt;Bluesky network&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;AT Protocol repos, relay firehose&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;fillColor=light-dark(#f3f2ee,#262624);strokeColor=light-dark(#8a887f,#77766f);strokeWidth=1.25;align=center;" vertex="1" parent="1"><mxGeometry x="35" y="120" width="170" height="56" as="geometry"/></mxCell>
        <mxCell id="ovw-v9" value='&lt;b style="font-size:13px"&gt;Jetstream v2&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;us-east (primary)&lt;br&gt;us-west (failover)&lt;br&gt;JSON over WebSocket&lt;br&gt;36 h replay window&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=12;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6250d6,#9085e9);strokeWidth=2;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="35" y="215" width="170" height="112" as="geometry"/></mxCell>
        <mxCell id="ovw-v10" value='&lt;span style="font-size:11px"&gt;&lt;b&gt;Subscribed collections&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;feed.post&lt;/span&gt; · &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;feed.like&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;feed.repost&lt;/span&gt; · &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;graph.follow&lt;/span&gt;&lt;br&gt;&lt;br&gt;About 270 events/s observed (2026-11-19)&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="37" y="345" width="170" height="110" as="geometry"/></mxCell>
        <mxCell id="ovw-v11" value='&lt;b style="font-size:13px"&gt;bluesky-jetstream-ingest&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;continuous serverless job&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;jetstream_ingest.py&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;appends every 30 s&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=12;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a35f25,#d48d52);strokeWidth=2;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="255" y="215" width="170" height="112" as="geometry"/></mxCell>
