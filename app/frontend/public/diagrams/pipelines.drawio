        <mxCell id="b2g-e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);dashed=1;dashPattern=5 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2g-v4" target="b2g-v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="b2g-e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);dashed=1;dashPattern=5 4;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.32;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2g-v5" target="b2g-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="b2g-v17" value='&lt;b style="font-size:12px"&gt;Model Serving&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;databricks-qwen3-&lt;br&gt;embedding-0-6b&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;1,024-d, multilingual&lt;br&gt;batches of 32&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;fillColor=light-dark(#f3f2ee,#262624);strokeColor=light-dark(#8a887f,#77766f);strokeWidth=1.25;align=center;" vertex="1" parent="1"><mxGeometry x="1210" y="112" width="170" height="120" as="geometry"/></mxCell>
        <mxCell id="b2g-e18" value="embed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);dashed=1;dashPattern=5 4;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2g-v8" target="b2g-v17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="755" y="100"/><mxPoint x="1195" y="100"/><mxPoint x="1195" y="148"/></Array></mxGeometry></mxCell>
        <mxCell id="b2g-v19" value='&lt;b style="font-size:12px;letter-spacing:.06em"&gt;WINDOW SCHEDULER · main loop&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=12;spacing=6;rounded=1;arcSize=2;absoluteArcSize=1;fillColor=light-dark(#f6f5f2,#151514);strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="310" height="838" as="geometry"/></mxCell>
        <mxCell id="b2g-v20" value='&lt;b style="font-size:13px"&gt;events_raw&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;bronze&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a35f25,#d48d52);strokeWidth=1.75;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="95" y="368" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="b2g-v21" value='&lt;b&gt;tail&lt;/b&gt; = &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;max(time_us)&lt;/span&gt; of bronze posts, today and yesterday' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="35" y="476" width="280" height="50" as="geometry"/></mxCell>
        <mxCell id="b2g-v22" value='&lt;b&gt;cursor&lt;/b&gt; = &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;max(time_us)&lt;/span&gt; in post_enriched &lt;span style="color:light-dark(#52514e,#c3c2b7)"&gt;(first run: tail − 30 min)&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="35" y="542" width="280" height="50" as="geometry"/></mxCell>
        <mxCell id="b2g-v23" value="&lt;b&gt;lo&lt;/b&gt; = cursor&lt;br&gt;&lt;b&gt;hi&lt;/b&gt; = min(tail − 60 s, lo + 120 s)" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="35" y="608" width="280" height="50" as="geometry"/></mxCell>
        <mxCell id="b2g-v24" value="hi &amp;gt; lo?" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=11;spacing=2;shape=rhombus;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="55" y="678" width="150" height="80" as="geometry"/></mxCell>
        <mxCell id="b2g-v25" value="sleep 20 s" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=center;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="222" y="693" width="95" height="50" as="geometry"/></mxCell>
        <mxCell id="b2g-v26" value="&lt;b&gt;process(lo, hi)&lt;/b&gt;&lt;br&gt;up to 3 attempts (10 s, 20 s backoff), then raise: the continuous job restarts and resumes from the cursor" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="35" y="784" width="280" height="92" as="geometry"/></mxCell>
        <mxCell id="b2g-v27" value="log lag and window stats, loop" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=center;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="35" y="896" width="280" height="40" as="geometry"/></mxCell>
        <mxCell id="b2g-e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);dashed=1;dashPattern=5 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2g-v20" target="b2g-v21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="b2g-e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2g-v21" target="b2g-v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="b2g-e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2g-v22" target="b2g-v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="b2g-e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2g-v23" target="b2g-v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="b2g-e32" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2g-v24" target="b2g-v25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="b2g-e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#898781;strokeWidth=1.25;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2g-v25" target="b2g-v21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="324" y="718"/><mxPoint x="324" y="501"/></Array></mxGeometry></mxCell>
        <mxCell id="b2g-e34" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.43;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2g-v24" target="b2g-v26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="b2g-e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2g-v26" target="b2g-v27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="b2g-v36" value='&lt;b style="font-size:12px;letter-spacing:.06em"&gt;PROCESS(lo, hi) · one window&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=12;spacing=6;rounded=1;arcSize=2;absoluteArcSize=1;fillColor=light-dark(#f6f5f2,#151514);strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="350" y="330" width="560" height="838" as="geometry"/></mxCell>
        <mxCell id="b2g-v37" value='① &lt;b&gt;read_window&lt;/b&gt;: SQL on events_raw, &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;collection = post AND operation = create AND lo &amp;lt; time_us ≤ hi&lt;/span&gt;&lt;br&gt;extracts text, langs, embed type, link URL and title, createdAt, reply, facets, tags, labels, via, bridged → pandas;&lt;br&gt;&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;drop_duplicates(did, rkey, rev)&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="365" y="368" width="530" height="90" as="geometry"/></mxCell>
        <mxCell id="b2g-v38" value="② &lt;b&gt;features&lt;/b&gt;: hashtags (facet #tag + tags, lowercased, max 20), mention count, self-labels, link domain" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="365" y="476" width="530" height="52" as="geometry"/></mxCell>
        <mxCell id="b2g-v39" value="③ &lt;b&gt;score_bots&lt;/b&gt;: 16 additive rules → bot_score, bot_reasons. &lt;b&gt;is_filtered&lt;/b&gt; = score ≥ 4 or an adult label. Accounts already in bot_accounts score +4; accounts scoring ≥ 3 on account rules become new bot_accounts rows" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="365" y="546" width="530" height="78" as="geometry"/></mxCell>
        <mxCell id="b2g-v40" value='④ &lt;b&gt;geo&lt;/b&gt; (clean posts): &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;geo_candidates&lt;/span&gt; → &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;best_geo&lt;/span&gt; fills geo_* columns; every candidate with confidence ≥ 0.25 → post_geo rows' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="365" y="642" width="530" height="60" as="geometry"/></mxCell>
        <mxCell id="b2g-v41" value="⑤ &lt;b&gt;embed&lt;/b&gt; (clean posts): URLs stripped, max 500 chars, link title added when short, skip under 12 chars; seeded sample of at most 600 per window; 6 threads, 3 retries; more than half the batches failing fails the window" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="365" y="720" width="530" height="78" as="geometry"/></mxCell>
        <mxCell id="b2g-v42" value="⑥ &lt;b&gt;topics&lt;/b&gt;: cosine against M. Nearest row is an anchor → no topic; else the top 3 with score ≥ 0.62 (text ≥ 25 chars) → post_topics (iptc); rank 1 → topic_qcode, topic_label, topic_l1" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="365" y="816" width="530" height="64" as="geometry"/></mxCell>
        <mxCell id="b2g-v43" value="⑦ &lt;b&gt;people, companies, hashtags&lt;/b&gt; (every clean post, not only the sample): name matcher on text and hashtags → up to 5 entities → post_topics (person or company, Wikidata QID, confidence as score); hashtags → post_topics (hashtag)" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="365" y="898" width="530" height="78" as="geometry"/></mxCell>
        <mxCell id="b2g-v44" value="⑧ &lt;b&gt;assemble post_enriched&lt;/b&gt;: one row per post, filtered posts included with their scores; L2-normalised embedding; enrich_version 1" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="365" y="994" width="530" height="58" as="geometry"/></mxCell>
        <mxCell id="b2g-v45" value="⑨ &lt;b&gt;write in order&lt;/b&gt;: post_geo → post_topics → bot_accounts → &lt;b&gt;post_enriched last&lt;/b&gt;, because it holds the cursor. A crash re-runs the window, so the first three can get duplicate rows (consumers dedupe on uri)" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="365" y="1070" width="530" height="78" as="geometry"/></mxCell>
        <mxCell id="b2g-e46" value="post creates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2g-v20" target="b2g-v37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="b2g-e47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2g-v26" target="b2g-v37"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="340" y="830"/><mxPoint x="340" y="444"/></Array></mxGeometry></mxCell>
        <mxCell id="b2g-e48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2g-v37" target="b2g-v38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="b2g-e49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2g-v38" target="b2g-v39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
