        <mxCell id="s2b-v52" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11.5px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;color:light-dark(#52514e,#c3c2b7);font-weight:bold&quot;&gt;column&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;color:light-dark(#52514e,#c3c2b7);font-weight:bold&quot;&gt;from the event&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:88px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;seq&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;event:seq::bigint&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:88px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;time_us&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;unix_micros(event:time)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:light-dark(#52514e,#c3c2b7)&quot;&gt;resume cursor&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:88px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;event_time&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;to_timestamp(event:time)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:88px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;event_date&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;to_date(…)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:88px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;kind&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;$type&lt;/span&gt; after '#'&lt;br&gt;&lt;span style=&quot;color:light-dark(#52514e,#c3c2b7)&quot;&gt;commit · identity · account&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:88px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;did&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;event:did&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:88px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;collection&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;event:collection&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:88px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;operation&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;&lt;span style=&quot;color:light-dark(#52514e,#c3c2b7)&quot;&gt;create · update · delete&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:88px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;rkey&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;event:rkey&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:88px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;rev&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;event:rev&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:light-dark(#52514e,#c3c2b7)&quot;&gt;orders changes per repo&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:88px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;event&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;whole payload, &lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;VARIANT&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:88px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;ingested_at&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;current_timestamp()&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Clustered by (event_date, collection). Append-only; duplicates are expected.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Frame shape&lt;/b&gt; &lt;span style=&quot;color:light-dark(#52514e,#c3c2b7)&quot;&gt;(abridged: the fields the code reads)&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:10.5px&quot;&gt;{&quot;$type&quot;: &quot;message&quot;,&lt;br&gt;&amp;nbsp;&quot;payload&quot;: {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;$type&quot;: &quot;…#commit&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;seq&quot;: …, &quot;time&quot;: &quot;2026-11-19T…Z&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;did&quot;: &quot;did:plc:…&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;collection&quot;: &quot;app.bsky.feed.post&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;operation&quot;: &quot;create&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;rkey&quot;: …, &quot;rev&quot;: …, &quot;cid&quot;: …,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;record&quot;: {&quot;text&quot;: …, &quot;langs&quot;: […],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;createdAt&quot;: …}}}&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="s2b-v51"><mxGeometry x="0" y="28" width="270" height="672" as="geometry"/></mxCell>
        <mxCell id="s2b-e53" value="append" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.79;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2b-v37" target="s2b-v51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s2b-e54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);dashed=1;dashPattern=5 4;exitX=0;exitY=0.07;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2b-v51" target="s2b-v30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s2b-v55" value="&lt;span style=&quot;font-size:12.5px&quot;&gt;&lt;b&gt;Delivery is at-least-once.&lt;/b&gt; The 10 s rewind and every reconnect re-read events, so &lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;events_raw&lt;/span&gt; holds duplicates; silver drops them on (did, rkey, rev). Cursors are timestamps because &lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;seq&lt;/span&gt; differs between Jetstream hosts. A stop longer than Jetstream's 36 h replay window leaves a permanent gap.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#f7f6f3,#2a2a28);strokeColor=light-dark(#a35f25,#d48d52);align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="822" width="1360" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="b2s" name="Bronze → Silver">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="b2s-v1" value='&lt;b&gt;Bronze → Silver: &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:18px"&gt;silver_pipeline.py&lt;/span&gt;&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=20;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="30" as="geometry"/></mxCell>
        <mxCell id="b2s-v2" value='Lakeflow pipeline &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px"&gt;bluesky-silver&lt;/span&gt; (continuous, serverless). One function, &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px"&gt;define_table&lt;/span&gt;, is applied to four collections; each becomes a current-state streaming table.' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=13;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1360" height="22" as="geometry"/></mxCell>
        <mxCell id="b2s-v3" value='&lt;b style="font-size:13px"&gt;events_raw&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;bronze&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a35f25,#d48d52);strokeWidth=1.75;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="160" height="100" as="geometry"/></mxCell>
        <mxCell id="b2s-v4" value='&lt;span style="font-size:11px"&gt;Read as a stream, incrementally.&lt;br&gt;&lt;br&gt;Only &lt;b&gt;commit&lt;/b&gt; events reach silver. Identity and account events, and the history of deletes, stay in bronze.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#f7f6f3,#2a2a28);strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="252" width="160" height="210" as="geometry"/></mxCell>
        <mxCell id="b2s-v5" value='&lt;b style="font-size:12px;letter-spacing:.06em"&gt;define_table(name, collection, columns) · once per table&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=12;spacing=6;rounded=1;arcSize=2;absoluteArcSize=1;fillColor=light-dark(#f6f5f2,#151514);strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="215" y="84" width="560" height="636" as="geometry"/></mxCell>
        <mxCell id="b2s-v6" value='&lt;b&gt;source&lt;/b&gt; &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11.5px"&gt;spark.readStream.table(events_raw)&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="235" y="130" width="520" height="46" as="geometry"/></mxCell>
        <mxCell id="b2s-v7" value="&lt;b&gt;filter&lt;/b&gt; &lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11.5px&quot;&gt;kind = 'commit' AND collection = '&amp;lt;collection&amp;gt;'&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="235" y="196" width="520" height="46" as="geometry"/></mxCell>
        <mxCell id="b2s-v8" value="&lt;b&gt;watermark&lt;/b&gt; &lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11.5px&quot;&gt;withWatermark('event_time', '15 minutes')&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="235" y="262" width="520" height="46" as="geometry"/></mxCell>
        <mxCell id="b2s-v9" value="&lt;b&gt;dedupe&lt;/b&gt; &lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11.5px&quot;&gt;dropDuplicatesWithinWatermark(did, rkey, rev)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:light-dark(#52514e,#c3c2b7)&quot;&gt;drops the ingest job's re-reads (10 s rewind, reconnects)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="235" y="328" width="520" height="58" as="geometry"/></mxCell>
        <mxCell id="b2s-v10" value="&lt;b&gt;project&lt;/b&gt; did, rkey, &lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11.5px&quot;&gt;uri = 'at://' || did || '/&amp;lt;collection&amp;gt;/' || rkey&lt;/span&gt;,&lt;br&gt;the table's columns parsed from the &lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;VARIANT&lt;/span&gt;, operation, rev, event_time" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="235" y="406" width="520" height="76" as="geometry"/></mxCell>
        <mxCell id="b2s-v11" value='&lt;b&gt;temporary view&lt;/b&gt; &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11.5px"&gt;&amp;lt;name&amp;gt;_changes&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="235" y="502" width="520" height="40" as="geometry"/></mxCell>
        <mxCell id="b2s-v12" value="&lt;b&gt;AUTO CDC flow&lt;/b&gt; into streaming table &lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11.5px&quot;&gt;&amp;lt;name&amp;gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11.5px&quot;&gt;create_auto_cdc_flow(&lt;br&gt;&amp;nbsp;&amp;nbsp;keys = [did, rkey],&lt;br&gt;&amp;nbsp;&amp;nbsp;sequence_by = rev,&lt;br&gt;&amp;nbsp;&amp;nbsp;apply_as_deletes = operation = 'delete',&lt;br&gt;&amp;nbsp;&amp;nbsp;except_column_list = [operation],&lt;br&gt;&amp;nbsp;&amp;nbsp;stored_as_scd_type = 1)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#68717d,#a3acb6);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="235" y="562" width="520" height="140" as="geometry"/></mxCell>
