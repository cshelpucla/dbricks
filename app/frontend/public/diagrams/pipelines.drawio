  <diagram id="rules" name="Enrichment rules">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="rules-v1" value="&lt;b&gt;Enrichment rules: bots, geo and topics&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=20;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="30" as="geometry"/></mxCell>
        <mxCell id="rules-v2" value='The thresholds as implemented in &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px"&gt;enrich_lib.py&lt;/span&gt; (VERSION 1). The contract is &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px"&gt;docs/ENRICHMENT_SPEC.md&lt;/span&gt;.' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=13;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1360" height="22" as="geometry"/></mxCell>
        <mxCell id="rules-v3" value="Bot and spam scoring · score_bots" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=28;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#fbf2d6,#2a2410);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="20" y="84" width="450" height="780" as="geometry"/></mxCell>
        <mxCell id="rules-v4" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;color:light-dark(#52514e,#c3c2b7);font-weight:bold&quot;&gt;reason&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;color:light-dark(#52514e,#c3c2b7);font-weight:bold&quot;&gt;condition (per window)&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;color:light-dark(#52514e,#c3c2b7);font-weight:bold&quot;&gt;points&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:104px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;rate&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;account posts at least 6 per minute in the window&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:62px&quot;&gt;&lt;b&gt;+3&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:104px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;links&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;account has 5+ posts and 90%+ are link cards&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:62px&quot;&gt;&lt;b&gt;+2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:104px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;nolang&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;account has 5+ posts and 90%+ have no language&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:62px&quot;&gt;&lt;b&gt;+1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:104px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;dup_text&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;same normalised text (20+ chars) 3+ times, any accounts&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:62px&quot;&gt;&lt;b&gt;+4&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:104px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;dup_self&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;account repeats identical text (10+ chars)&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:62px&quot;&gt;&lt;b&gt;+2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:104px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;backfill&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;createdAt more than 7 days before arrival&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:62px&quot;&gt;&lt;b&gt;+4&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:104px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;future&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;createdAt more than 1 hour after arrival&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:62px&quot;&gt;&lt;b&gt;+1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:104px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;tag_stuffing&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;8 or more hashtags&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:62px&quot;&gt;&lt;b&gt;+2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:104px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;mention_stuffing&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;6 or more mentions&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:62px&quot;&gt;&lt;b&gt;+2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:104px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;spam_words&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;airdrop, &quot;dm me&quot;, telegram, whatsapp, onlyfans, link in bio, …&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:62px&quot;&gt;&lt;b&gt;+2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:104px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;label_bot&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;self-label bot&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:62px&quot;&gt;&lt;b&gt;+4&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:104px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;via_bot&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;via field contains &quot;bot&quot;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:62px&quot;&gt;&lt;b&gt;+2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:104px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;autoposter&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;link via dlvr.it, ift.tt, buff.ly, ow.ly&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:62px&quot;&gt;&lt;b&gt;+1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:104px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;bridged&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;bridged from another network&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:62px&quot;&gt;&lt;b&gt;+1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:104px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;adult&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;porn, sexual, nudity or adult label&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:62px&quot;&gt;&lt;b&gt;+2, always filtered&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:104px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;known_bot&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;account already in bot_accounts&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:62px&quot;&gt;&lt;b&gt;+4&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:104px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;empty&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;text under 3 chars (image-only posts)&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:62px&quot;&gt;&lt;b&gt;0, informational&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px&quot;&gt;&lt;b&gt;is_filtered&lt;/b&gt; = bot_score ≥ 4, or any adult label. Every post stays in post_enriched with its score and reasons; only clean posts get geo, embeddings and topics.&lt;br&gt;&lt;br&gt;&lt;b&gt;New bot accounts&lt;/b&gt;: rate + links + nolang + dup_self ≥ 3 (highest over the account's posts) → appended to bot_accounts; later windows add known_bot +4.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=11;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="rules-v3"><mxGeometry x="0" y="28" width="450" height="752" as="geometry"/></mxCell>
        <mxCell id="rules-v5" value="Geo extraction · geo_candidates → best_geo" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=28;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#fbf2d6,#2a2410);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="490" y="84" width="440" height="780" as="geometry"/></mxCell>
        <mxCell id="rules-v6" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;color:light-dark(#52514e,#c3c2b7);font-weight:bold&quot;&gt;kind&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;color:light-dark(#52514e,#c3c2b7);font-weight:bold&quot;&gt;evidence&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;color:light-dark(#52514e,#c3c2b7);font-weight:bold&quot;&gt;conf.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:86px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;coords&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;lat,lon in text or link: @lat,lon, ?q=, mlat/mlon, geo:, decimal pair&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:40px&quot;&gt;&lt;b&gt;1.0&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:86px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;city&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;multi-word city name (New York, Buenos Aires)&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:40px&quot;&gt;&lt;b&gt;0.7&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:86px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;city&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;single word after in, at, near, from, to, …; or a hashtag; or non-Latin script&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:40px&quot;&gt;&lt;b&gt;0.6&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:86px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;city&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;single word, population 1M+, not ambiguous&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:40px&quot;&gt;&lt;b&gt;0.5&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:86px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;admin1&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;state or province (population-weighted centroid)&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:40px&quot;&gt;&lt;b&gt;0.5&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:86px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;lang_region&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;language region subtag: pt-BR, en-GB&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:40px&quot;&gt;&lt;b&gt;0.5&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:86px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;country&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;country name or alias (capital's coordinates)&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:40px&quot;&gt;&lt;b&gt;0.4&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:86px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;flag&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;flag emoji&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:40px&quot;&gt;&lt;b&gt;0.3&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:86px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;tld&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;link country TLD, not .tv .ly .co .io .ai … or youtu.be&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:40px&quot;&gt;&lt;b&gt;0.25&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:86px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;lang&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;language spoken in one country: ja, ko, th, vi, tr, pl, …&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:40px&quot;&gt;&lt;b&gt;0.15&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px&quot;&gt;&lt;b&gt;Matching&lt;/b&gt;: GeoNames cities with 15,000+ people. Latin names must be capitalised (unless the post is all caps); ambiguous names (Nice, Reading, Mobile, Turkey, Chad, Jordan, Georgia, …) need a preposition. Han, kana, Hangul and other uncased scripts match directly.&lt;br&gt;&lt;br&gt;&lt;b&gt;Keep&lt;/b&gt; candidates ≥ 0.15, one per (kind, place).&lt;br&gt;&lt;b&gt;Best&lt;/b&gt;: +0.1 for each other candidate in the same country (max 0.95, not coords); ties go to coords → city → admin1 → country → lang_region → flag, tld → lang.&lt;br&gt;&lt;br&gt;&lt;b&gt;Thresholds&lt;/b&gt;: post_geo stores ≥ 0.25 · the app's maps use ≥ 0.4 by default.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px&quot;&gt;&lt;b&gt;Worked example&lt;/b&gt;: &quot;Coffee in Lisbon ☕ 🇵🇹&quot;&lt;br&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;color:light-dark(#52514e,#c3c2b7);font-weight:bold&quot;&gt;kind&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;color:light-dark(#52514e,#c3c2b7);font-weight:bold&quot;&gt;match&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;color:light-dark(#52514e,#c3c2b7);font-weight:bold&quot;&gt;raw&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;color:light-dark(#52514e,#c3c2b7);font-weight:bold&quot;&gt;boosted&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:60px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;city&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;Lisbon, after &quot;in&quot;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:40px&quot;&gt;0.6&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:56px&quot;&gt;0.7&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:60px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;flag&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;🇵🇹 → Portugal&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:40px&quot;&gt;0.3&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:56px&quot;&gt;0.4&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;Both are in PT, so each gets +0.1. post_geo stores both rows with their raw scores; post_enriched takes Lisbon, geo_kind city, geo_confidence 0.7.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=11;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="rules-v5"><mxGeometry x="0" y="28" width="440" height="752" as="geometry"/></mxCell>
        <mxCell id="rules-v7" value='&lt;b style="font-size:12px;letter-spacing:.06em"&gt;TOPIC ASSIGNMENT · assign_topics&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=12;spacing=6;rounded=1;arcSize=2;absoluteArcSize=1;fillColor=light-dark(#fbf2d6,#2a2410);strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="950" y="84" width="430" height="780" as="geometry"/></mxCell>
        <mxCell id="rules-v8" value="&lt;b&gt;embed_text&lt;/b&gt;: post text without URLs, max 500 chars, link card title appended when short" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="965" y="124" width="400" height="56" as="geometry"/></mxCell>
        <mxCell id="rules-v9" value='&lt;b&gt;prefix&lt;/b&gt; &lt;span style="color:light-dark(#52514e,#c3c2b7)"&gt;"Identify which news topic category this social media post is about"&lt;/span&gt; → embedding endpoint → 1,024-d vector, L2-normalised' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="965" y="198" width="400" height="70" as="geometry"/></mxCell>
        <mxCell id="rules-v10" value="&lt;b&gt;S = E · M&lt;sup&gt;T&lt;/sup&gt;&lt;/b&gt; (cosine) against M = [IPTC concepts, levels 1–3 | 12 anchors]" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="965" y="286" width="400" height="56" as="geometry"/></mxCell>
        <mxCell id="rules-v11" value='nearest row is a&lt;br&gt;"no topic" anchor?' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=11;spacing=2;shape=rhombus;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="990" y="362" width="200" height="96" as="geometry"/></mxCell>
        <mxCell id="rules-v12" value='no IPTC topic&lt;br&gt;&lt;span style="font-size:11px"&gt;greetings, small talk, reactions&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=center;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1215" y="380" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="rules-v13" value="keep the &lt;b&gt;top 3&lt;/b&gt; concepts with score ≥ &lt;b&gt;0.62&lt;/b&gt;; posts under 25 chars get none" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="965" y="480" width="400" height="56" as="geometry"/></mxCell>
        <mxCell id="rules-v14" value="→ &lt;b&gt;post_topics&lt;/b&gt;: topic_type = iptc, rank 1–3, score" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="965" y="554" width="400" height="46" as="geometry"/></mxCell>
        <mxCell id="rules-v15" value="rank 1 → &lt;b&gt;post_enriched&lt;/b&gt;.topic_qcode, topic_label, topic_score; topic_l1 = label of its top-level ancestor (17 subjects)" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="965" y="618" width="400" height="70" as="geometry"/></mxCell>
        <mxCell id="rules-v16" value="hashtags → &lt;b&gt;post_topics&lt;/b&gt; with topic_type = hashtag (no rank, no score)" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="965" y="706" width="400" height="56" as="geometry"/></mxCell>
        <mxCell id="rules-v17" value='&lt;span style="font-size:11px"&gt;Anchors are short descriptions of chatter ("a greeting such as good morning", "emoji, laughter or an exclamation", …). Hierarchy: IPTC Media Topics, CC BY 4.0.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="965" y="778" width="400" height="76" as="geometry"/></mxCell>
        <mxCell id="rules-e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rules-v8" target="rules-v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="rules-e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rules-v9" target="rules-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="rules-e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rules-v10" target="rules-v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="rules-e21" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rules-v11" target="rules-v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="rules-e22" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.31;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rules-v11" target="rules-v13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="rules-e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rules-v13" target="rules-v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="rules-e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rules-v14" target="rules-v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ent" name="People &amp; companies">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ent-v1" value='&lt;b&gt;People and companies: &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:18px"&gt;taxonomy_job.py&lt;/span&gt; + &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:18px"&gt;entity_lib.py&lt;/span&gt;&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=20;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="30" as="geometry"/></mxCell>
        <mxCell id="ent-v2" value='Two weekly jobs pull reference lists from Wikipedia and Wikidata; the enrich job matches the names in every clean post. Contract: &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px"&gt;docs/ENRICHMENT_SPEC.md&lt;/span&gt; §7.5.' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=13;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1360" height="22" as="geometry"/></mxCell>
        <mxCell id="ent-v3" value='&lt;b style="font-size:12px;letter-spacing:.06em"&gt;SOURCES&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=12;spacing=6;rounded=1;arcSize=2;absoluteArcSize=1;fillColor=light-dark(#f1effc,#1f1c33);strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="84" width="290" height="560" as="geometry"/></mxCell>
        <mxCell id="ent-v4" value='&lt;b style="font-size:13px"&gt;Wikipedia: Vital articles&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Level 4 / People: about 1,900 figures editors judge essential, grouped by field&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;fillColor=light-dark(#f3f2ee,#262624);strokeColor=light-dark(#8a887f,#77766f);strokeWidth=1.25;align=center;" vertex="1" parent="1"><mxGeometry x="35" y="124" width="260" height="92" as="geometry"/></mxCell>
        <mxCell id="ent-v5" value='&lt;b style="font-size:13px"&gt;Wikipedia top-1000 pageviews&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;people in the English monthly list in at least 2 of the last 6 months, with 30+ Wikipedia editions&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;fillColor=light-dark(#f3f2ee,#262624);strokeColor=light-dark(#8a887f,#77766f);strokeWidth=1.25;align=center;" vertex="1" parent="1"><mxGeometry x="35" y="232" width="260" height="92" as="geometry"/></mxCell>
        <mxCell id="ent-v6" value='&lt;b style="font-size:13px"&gt;Wikidata (SPARQL)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;business-like classes: company, public company, bank, airline, car maker, social network, video game company, … with 30+ Wikipedia editions&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;fillColor=light-dark(#f3f2ee,#262624);strokeColor=light-dark(#8a887f,#77766f);strokeWidth=1.25;align=center;" vertex="1" parent="1"><mxGeometry x="35" y="380" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="ent-v7" value='&lt;span style="font-size:11px"&gt;Every entry resolves to a Wikidata item with an English label, aliases and a sitelink count (number of Wikipedia editions), which is the importance weight. People are confirmed as humans through Wikidata.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="37" y="506" width="256" height="120" as="geometry"/></mxCell>
        <mxCell id="ent-v8" value='&lt;b style="font-size:12px;letter-spacing:.06em"&gt;TAXONOMY JOBS · scheduled&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=12;spacing=6;rounded=1;arcSize=2;absoluteArcSize=1;fillColor=light-dark(#fbf2d6,#2a2410);strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="330" y="84" width="300" height="560" as="geometry"/></mxCell>
        <mxCell id="ent-v9" value='&lt;b style="font-size:13px"&gt;bluesky-taxonomy-people&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Mondays 03:00 UTC&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;taxonomy_job.py · entity_loader.py&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=12;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=2;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="345" y="124" width="270" height="92" as="geometry"/></mxCell>
        <mxCell id="ent-v10" value='&lt;b style="font-size:13px"&gt;bluesky-taxonomy-companies&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Mondays 03:30 UTC&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;taxonomy_job.py · entity_loader.py&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=12;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=2;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="345" y="389" width="270" height="92" as="geometry"/></mxCell>
        <mxCell id="ent-v11" value='&lt;span style="font-size:11.5px"&gt;&lt;b&gt;All or nothing&lt;/b&gt;: a table is replaced (overwrite) only after a complete pull of at least 500 people or 300 companies; otherwise the run fails and the old table stays.&lt;br&gt;&lt;br&gt;Run on demand with &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;taxonomy.sh&lt;/span&gt; or &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;jobs run-now&lt;/span&gt;.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#f7f6f3,#2a2a28);strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="345" y="236" width="270" height="134" as="geometry"/></mxCell>
        <mxCell id="ent-v12" value='&lt;span style="font-size:11.5px"&gt;Set &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;WIKI_CONTACT&lt;/span&gt; in config.env: Wikimedia asks API clients for a contact in the User-Agent and rate-limits anonymous ones hard.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="347" y="500" width="266" height="130" as="geometry"/></mxCell>
        <mxCell id="ent-v13" value='&lt;b style="font-size:12px;letter-spacing:.06em"&gt;TABLES&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=12;spacing=6;rounded=1;arcSize=2;absoluteArcSize=1;fillColor=light-dark(#fbf2d6,#2a2410);strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="650" y="84" width="230" height="560" as="geometry"/></mxCell>
        <mxCell id="ent-v14" value='&lt;b style="font-size:13px"&gt;taxonomy_people&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;kind = person&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=1.75;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="665" y="128" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="ent-v15" value='&lt;b style="font-size:13px"&gt;taxonomy_companies&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;kind = company&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=1.75;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="665" y="394" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="ent-v16" value='&lt;span style="font-size:11.5px"&gt;&lt;b&gt;Columns&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;qid, kind, label, description, aliases[], sitelinks, category, source, loaded_at&lt;/span&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#f7f6f3,#2a2a28);strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="665" y="226" width="200" height="150" as="geometry"/></mxCell>
        <mxCell id="ent-v17" value='&lt;b style="font-size:12px;letter-spacing:.06em"&gt;MATCHING · inside bluesky-enrich, step ⑦&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=12;spacing=6;rounded=1;arcSize=2;absoluteArcSize=1;fillColor=light-dark(#fbf2d6,#2a2410);strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="900" y="84" width="480" height="560" as="geometry"/></mxCell>
        <mxCell id="ent-v18" value='&lt;b&gt;every 10 min&lt;/b&gt;: re-read both tables; rebuild the matcher when &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;loaded_at&lt;/span&gt; changes &lt;span style="color:light-dark(#52514e,#c3c2b7)"&gt;(no tables yet → no entity matching)&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="915" y="124" width="450" height="56" as="geometry"/></mxCell>
        <mxCell id="ent-v19" value="Name rules · EntityMatcher" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=28;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#fbf2d6,#2a2410);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="915" y="196" width="450" height="300" as="geometry"/></mxCell>
        <mxCell id="ent-v20" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11.5px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;color:light-dark(#52514e,#c3c2b7);font-weight:bold&quot;&gt;match&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;color:light-dark(#52514e,#c3c2b7);font-weight:bold&quot;&gt;rule&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;color:light-dark(#52514e,#c3c2b7);font-weight:bold&quot;&gt;conf.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:96px&quot;&gt;&lt;b&gt;two or more words&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;case- and accent-insensitive, on word boundaries, possessives removed&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:36px&quot;&gt;&lt;b&gt;1.0&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:96px&quot;&gt;&lt;b&gt;hashtag&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;the name with spaces removed: &lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;#donaldtrump&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:36px&quot;&gt;&lt;b&gt;0.9&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:96px&quot;&gt;&lt;b&gt;one word&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;surname, mononym or brand, capitalised exactly as written; an everyday word (Apple, Cook) must be mid-sentence unless in capitals&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:36px&quot;&gt;&lt;b&gt;0.7&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;span style=&quot;font-size:11.5px&quot;&gt;&lt;br&gt;A one-word name claimed by several entities goes to the best known if it has 1.5× the runner-up's sitelinks, otherwise nobody (&quot;Bush&quot;). Surnames that are first names, months or weekdays never match alone; one-word person names under 4 letters are ignored. Company suffixes are stripped (&quot;Alphabet Inc.&quot; → Alphabet). At most 5 entities per post.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="ent-v19"><mxGeometry x="0" y="28" width="450" height="272" as="geometry"/></mxCell>
        <mxCell id="ent-v21" value='→ &lt;b&gt;post_topics&lt;/b&gt;: topic_type = person or company, topic_id = Wikidata QID (e.g. &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;Q22686&lt;/span&gt;), topic_label, score = confidence' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="915" y="512" width="450" height="60" as="geometry"/></mxCell>
        <mxCell id="ent-e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);dashed=1;dashPattern=5 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent-v4" target="ent-v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ent-e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);dashed=1;dashPattern=5 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent-v5" target="ent-v9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="278"/><mxPoint x="320" y="193"/></Array></mxGeometry></mxCell>
        <mxCell id="ent-e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);dashed=1;dashPattern=5 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent-v6" target="ent-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ent-e25" value="overwrite" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent-v9" target="ent-v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ent-e26" value="overwrite" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent-v10" target="ent-v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ent-e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);dashed=1;dashPattern=5 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent-v14" target="ent-v18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ent-e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);dashed=1;dashPattern=5 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent-v15" target="ent-v18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890" y="434"/><mxPoint x="890" y="166"/></Array></mxGeometry></mxCell>
        <mxCell id="ent-e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent-v18" target="ent-v19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ent-e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent-v19" target="ent-v21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ent-v31" value="&lt;b&gt;Examples&lt;/b&gt; (from the spec)" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="664" width="1360" height="26" as="geometry"/></mxCell>
        <mxCell id="ent-v32" value='"I love Apple products"' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=center;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="150" height="44" as="geometry"/></mxCell>
        <mxCell id="ent-v33" value='&lt;span style="font-size:11.5px"&gt;Apple · company · 0.7&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=1.25;align=center;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="192" y="700" width="150" height="44" as="geometry"/></mxCell>
        <mxCell id="ent-e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent-v32" target="ent-v33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ent-v35" value='"Apple pie"' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=center;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="365" y="700" width="150" height="44" as="geometry"/></mxCell>
        <mxCell id="ent-v36" value='&lt;span style="font-size:11.5px"&gt;no match: everyday word at the start&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=1.25;align=center;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="537" y="700" width="150" height="44" as="geometry"/></mxCell>
        <mxCell id="ent-e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent-v35" target="ent-v36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ent-v38" value="#donaldtrump" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=center;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="710" y="700" width="150" height="44" as="geometry"/></mxCell>
        <mxCell id="ent-v39" value='&lt;span style="font-size:11.5px"&gt;Donald Trump · person · 0.9&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=1.25;align=center;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="882" y="700" width="150" height="44" as="geometry"/></mxCell>
        <mxCell id="ent-e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent-v38" target="ent-v39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ent-v41" value='"Bush said …"' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=center;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1055" y="700" width="150" height="44" as="geometry"/></mxCell>
        <mxCell id="ent-v42" value='&lt;span style="font-size:11.5px"&gt;no match: no dominant owner&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=1.25;align=center;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1227" y="700" width="150" height="44" as="geometry"/></mxCell>
        <mxCell id="ent-e43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent-v41" target="ent-v42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ent-v44" value='&lt;span style="font-size:12px"&gt;Known limits: English names only; @handle mentions are not used. The Topic map shows the top 5 people and companies per cluster from these rows.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="758" width="1360" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="map" name="Gold → Topic map">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="map-v1" value='&lt;b&gt;Gold → Topic map: &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:18px"&gt;map_job.py&lt;/span&gt; + &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:18px"&gt;map_lib.py&lt;/span&gt;&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=20;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="30" as="geometry"/></mxCell>
        <mxCell id="map-v2" value='Job &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px"&gt;bluesky-topic-map&lt;/span&gt; runs every 2 hours (Quartz &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px"&gt;0 0 0/2 * * ?&lt;/span&gt;, UTC). It has no cursor: each run rebuilds the map from the last 24 hours and overwrites both tables.' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=13;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1360" height="22" as="geometry"/></mxCell>
        <mxCell id="map-v3" value='&lt;b style="font-size:13px"&gt;post_enriched&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;clean, embedded&lt;br&gt;posts&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=1.75;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="116" width="160" height="96" as="geometry"/></mxCell>
        <mxCell id="map-v4" value='&lt;b&gt;sample&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:10.5px"&gt;SELECT uri, embedding, topic_l1, topic_label, hashtags, text FROM post_enriched WHERE embedded AND NOT is_filtered AND event_time &amp;gt; now − 24 h ORDER BY rand() LIMIT 40000&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="220" y="104" width="290" height="120" as="geometry"/></mxCell>
        <mxCell id="map-v5" value="200 posts&lt;br&gt;or more?" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=11;spacing=2;shape=rhombus;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="540" y="114" width="130" height="100" as="geometry"/></mxCell>
        <mxCell id="map-v6" value="keep the previous map; exit" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=11;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#c93a39,#e66767);strokeWidth=1.25;align=center;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="540" y="252" width="130" height="56" as="geometry"/></mxCell>
        <mxCell id="map-v7" value="&lt;b&gt;reduce&lt;/b&gt;&lt;br&gt;PCA, 1,024 → 50 dimensions" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="700" y="124" width="150" height="80" as="geometry"/></mxCell>
        <mxCell id="map-v8" value="&lt;b&gt;layout&lt;/b&gt;&lt;br&gt;UMAP to 2-D: cosine, 15 neighbours, min_dist 0.05, seed 42; scaled to 0–100" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="880" y="124" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="map-v9" value="&lt;b&gt;cluster&lt;/b&gt;&lt;br&gt;HDBSCAN on the 2-D layout, so clusters match the islands people see. min_cluster_size = max(30, n / 500), min_samples 10; −1 = no cluster" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1120" y="114" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="map-v10" value="&lt;b&gt;summarize&lt;/b&gt; each cluster: size, median x and y, majority IPTC topic and its share, top 5 hashtags, the 12 posts nearest its centre" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1120" y="330" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="map-v11" value='&lt;b&gt;name&lt;/b&gt; each cluster (4 in parallel, 4 retries with backoff)&lt;br&gt;prompt: the 12 posts + hashtag and IPTC hints; reply JSON &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;{label: 2–5 words, topic: one of the 17 IPTC subjects or none}&lt;/span&gt;&lt;br&gt;&lt;span style="color:light-dark(#52514e,#c3c2b7)"&gt;fallback: majority IPTC label if its share ≥ 0.15, else the top hashtag if ≥ 0.1, else "Cluster N"&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="730" y="316" width="360" height="138" as="geometry"/></mxCell>
        <mxCell id="map-v12" value='&lt;b style="font-size:12px"&gt;Model Serving&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;databricks-claude-haiku-5-5&lt;/span&gt;&lt;span style="font-size:11px"&gt; · MAP_LABEL_ENDPOINT&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;fillColor=light-dark(#f3f2ee,#262624);strokeColor=light-dark(#8a887f,#77766f);strokeWidth=1.25;align=center;" vertex="1" parent="1"><mxGeometry x="730" y="480" width="360" height="50" as="geometry"/></mxCell>
        <mxCell id="map-v13" value='&lt;b&gt;write&lt;/b&gt;, both stamped with the same &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;computed_at&lt;/span&gt;:&lt;br&gt;1. overwrite &lt;b&gt;topic_clusters&lt;/b&gt;&lt;br&gt;2. overwrite &lt;b&gt;post_map&lt;/b&gt;&lt;br&gt;&lt;span style="color:light-dark(#52514e,#c3c2b7)"&gt;The app joins them on computed_at, so a reader mid-refresh sees no labels rather than mismatched ones.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="400" y="316" width="300" height="138" as="geometry"/></mxCell>
        <mxCell id="map-v14" value="topic_clusters" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=28;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#fbf2d6,#2a2410);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="340" height="160" as="geometry"/></mxCell>
        <mxCell id="map-v15" value='&lt;span style="font-size:11.5px"&gt;&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;cluster_id, label, topic_l1, label_source&lt;/span&gt; (llm · iptc · hashtag · none), &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;n, x, y, iptc_label, iptc_l1, iptc_l1_share, top_hashtags, computed_at&lt;/span&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="map-v14"><mxGeometry x="0" y="28" width="340" height="132" as="geometry"/></mxCell>
        <mxCell id="map-v16" value="post_map" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=28;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#fbf2d6,#2a2410);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="30" y="476" width="340" height="90" as="geometry"/></mxCell>
        <mxCell id="map-v17" value='&lt;span style="font-size:11.5px"&gt;&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;uri, x, y, cluster_id&lt;/span&gt; (null when in no cluster), &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;computed_at&lt;/span&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="map-v16"><mxGeometry x="0" y="28" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="map-e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="map-v3" target="map-v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="map-e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="map-v4" target="map-v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="map-e20" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#c93a39,#e66767);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#c93a39,#e66767);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);dashed=1;dashPattern=5 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="map-v5" target="map-v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="map-e21" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="map-v5" target="map-v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="map-e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="map-v7" target="map-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="map-e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="map-v8" target="map-v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="map-e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="map-v9" target="map-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="map-e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="map-v10" target="map-v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="map-e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;startArrow=block;startFill=1;startSize=6;" edge="1" parent="1" source="map-v11" target="map-v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="map-e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="map-v11" target="map-v13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="map-e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="map-v13" target="map-v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="map-e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="map-v13" target="map-v16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="385" y="433"/><mxPoint x="385" y="521"/></Array></mxGeometry></mxCell>
        <mxCell id="map-v30" value='&lt;span style="font-size:12.5px"&gt;&lt;b&gt;Used by the app.&lt;/b&gt; Topic map tab: &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;post_map ⨝ topic_clusters&lt;/span&gt; (same cluster_id and computed_at) &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;⨝ post_enriched&lt;/span&gt;, clean posts in the chosen time window, with People and Companies panels from post_topics. The Ask tab adds cluster_id to its dataset. The app serves labelled demo data until post_map, topic_clusters and post_enriched all have rows.&lt;br&gt;&lt;br&gt;&lt;b&gt;Dependencies&lt;/b&gt; pinned for serverless environment 3: umap-learn 0.5.7, numba 0.60.0, pynndescent 0.5.13 (scikit-learn 1.4.2 is preinstalled and provides HDBSCAN).&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#f7f6f3,#2a2a28);strokeColor=light-dark(#a87400,#e0a82e);align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="1360" height="104" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="srv" name="Serving &amp; app">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="srv-v1" value="&lt;b&gt;Serving: the Databricks App&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=20;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="30" as="geometry"/></mxCell>
        <mxCell id="srv-v2" value='App &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px"&gt;bluesky-analytics&lt;/span&gt; (&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px"&gt;app/&lt;/span&gt;): FastAPI under uvicorn serves the JSON API under &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px"&gt;/api&lt;/span&gt; and the static UI from &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px"&gt;frontend/public&lt;/span&gt;.' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=13;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1360" height="22" as="geometry"/></mxCell>
        <mxCell id="srv-v3" value='&lt;b style="font-size:12px;letter-spacing:.06em"&gt;UNITY CATALOG · datawranglers.bluesky&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=12;spacing=6;rounded=1;arcSize=2;absoluteArcSize=1;fillColor=light-dark(#f6f5f2,#151514);strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="84" width="330" height="716" as="geometry"/></mxCell>
        <mxCell id="srv-v4" value="bronze" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=24;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#f8ece1,#2b2017);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a35f25,#d48d52);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="35" y="124" width="300" height="62" as="geometry"/></mxCell>
        <mxCell id="srv-v5" value='&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;events_raw&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="srv-v4"><mxGeometry x="0" y="24" width="300" height="38" as="geometry"/></mxCell>
        <mxCell id="srv-v6" value="silver" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=24;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#eef0f2,#212529);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#68717d,#a3acb6);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="35" y="198" width="300" height="62" as="geometry"/></mxCell>
        <mxCell id="srv-v7" value='&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;posts · likes · reposts · follows&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="srv-v6"><mxGeometry x="0" y="24" width="300" height="38" as="geometry"/></mxCell>
        <mxCell id="srv-v8" value="gold" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=24;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#fbf2d6,#2a2410);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="35" y="272" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="srv-v9" value='&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;post_enriched · post_topics · post_geo&lt;br&gt;bot_accounts · topic_taxonomy&lt;br&gt;taxonomy_people · taxonomy_companies&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="srv-v8"><mxGeometry x="0" y="24" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="srv-v10" value="gold · topic map" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=24;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#fbf2d6,#2a2410);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="35" y="384" width="300" height="108" as="geometry"/></mxCell>
        <mxCell id="srv-v11" value='&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;post_map · topic_clusters&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px"&gt;rebuilt every 2 h by bluesky-topic-map; joined on computed_at&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="srv-v10"><mxGeometry x="0" y="24" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="srv-v12" value="app-owned" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=24;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#e8f0fb,#142238);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#2a78d6,#3987e5);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="35" y="504" width="300" height="74" as="geometry"/></mxCell>
        <mxCell id="srv-v13" value='&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;chat_messages&lt;/span&gt;&lt;span style="font-size:11.5px"&gt; · Ask-tab history,&lt;br&gt;one row per message&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="srv-v12"><mxGeometry x="0" y="24" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="srv-v14" value="system catalog" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=24;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#f3f2ee,#262624);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#8a887f,#77766f);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="35" y="590" width="300" height="74" as="geometry"/></mxCell>
        <mxCell id="srv-v15" value='&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;system.billing.usage · list_prices&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px"&gt;an account admin must grant read access&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="srv-v14"><mxGeometry x="0" y="24" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="srv-v16" value='&lt;span style="font-size:11.5px"&gt;&lt;b&gt;information_schema.tables&lt;/b&gt; tells the Data model tab which tables exist.&lt;br&gt;&lt;br&gt;Until post_map, topic_clusters and post_enriched all have rows, the Topic map serves labelled demo data.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacing=4;fontColor=light-dark(#52514e,#c3c2b7);" vertex="1" parent="1"><mxGeometry x="35" y="680" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="srv-v17" value='&lt;b style="font-size:12px;letter-spacing:.06em"&gt;PLATFORM SERVICES&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=12;spacing=6;rounded=1;arcSize=2;absoluteArcSize=1;fillColor=light-dark(#f6f5f2,#151514);strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="370" y="84" width="270" height="716" as="geometry"/></mxCell>
        <mxCell id="srv-v18" value="&lt;b style=&quot;font-size:13px&quot;&gt;SQL warehouse&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Statement Execution API&lt;br&gt;runs as the app's service principal&lt;br&gt;named parameters, inline JSON results&lt;br&gt;bound through the app resource &lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;sql-warehouse&lt;/span&gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=12;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#2a78d6,#3987e5);strokeWidth=2;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="385" y="130" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="srv-v19" value='&lt;b style="font-size:13px"&gt;Jobs and Pipelines APIs&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;status and run history; pause / resume&lt;br&gt;(CAN_MANAGE on jobs, CAN_RUN on the pipeline)&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;fillColor=light-dark(#f3f2ee,#262624);strokeColor=light-dark(#8a887f,#77766f);strokeWidth=1.25;align=center;" vertex="1" parent="1"><mxGeometry x="385" y="340" width="240" height="96" as="geometry"/></mxCell>
        <mxCell id="srv-v20" value='&lt;b style="font-size:13px"&gt;Model Serving chat&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;databricks-claude-sonnet-5-5&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;env CHAT_ENDPOINT&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;fillColor=light-dark(#f3f2ee,#262624);strokeColor=light-dark(#8a887f,#77766f);strokeWidth=1.25;align=center;" vertex="1" parent="1"><mxGeometry x="385" y="496" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="srv-v21" value="&lt;span style=&quot;font-size:11.5px&quot;&gt;&lt;b&gt;Access&lt;/b&gt; (scripts/deploy.sh)&lt;br&gt;USE CATALOG, USE SCHEMA and SELECT on the schema for the app's service principal; CAN_USE on the warehouse; write access for chat_messages; CAN_MANAGE on the ingest, enrich and topic map jobs and CAN_RUN on the pipeline for the Control tab.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#f7f6f3,#2a2a28);strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="385" y="640" width="240" height="140" as="geometry"/></mxCell>
        <mxCell id="srv-v22" value='&lt;b style="font-size:12px;letter-spacing:.06em"&gt;DATABRICKS APP · bluesky-analytics&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=12;spacing=6;rounded=1;arcSize=2;absoluteArcSize=1;fillColor=light-dark(#e8f0fb,#142238);strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="660" y="84" width="720" height="716" as="geometry"/></mxCell>
        <mxCell id="srv-v23" value='&lt;b&gt;Workspace users&lt;/b&gt; → Databricks Apps proxy: sign-in, user email forwarded as &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;x-forwarded-email&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;fillColor=light-dark(#f3f2ee,#262624);strokeColor=light-dark(#8a887f,#77766f);strokeWidth=1.25;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="120" width="680" height="44" as="geometry"/></mxCell>
        <mxCell id="srv-v24" value="Backend · backend/main.py (FastAPI)" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=28;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#e8f0fb,#142238);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#2a78d6,#3987e5);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="680" y="186" width="680" height="372" as="geometry"/></mxCell>
        <mxCell id="srv-v25" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11.5px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;color:light-dark(#52514e,#c3c2b7);font-weight:bold&quot;&gt;tab&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;color:light-dark(#52514e,#c3c2b7);font-weight:bold&quot;&gt;API&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;color:light-dark(#52514e,#c3c2b7);font-weight:bold&quot;&gt;what it does&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:80px&quot;&gt;Topic map&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:178px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;/api/meta&lt;br&gt;/api/clusters&lt;br&gt;/api/clusters/{id}/posts&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;AutoSource&lt;/b&gt;: WarehouseSource once post_map, topic_clusters and post_enriched have rows (rechecked every 60 s), else DemoSource. post_map ⨝ topic_clusters (same computed_at) ⨝ post_enriched, clean posts only; People and Companies panels from post_topics&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:80px&quot;&gt;World map&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:178px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;/api/geo&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;LiveGeo&lt;/b&gt;: post_enriched by place or country, geo_confidence ≥ min_conf (0.4)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:80px&quot;&gt;Pipelines&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:178px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;/api/pipelines&lt;br&gt;/api/pipelines/{key}/stats&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;LivePipelines&lt;/b&gt;: ingest, silver, enrich and topic map; rows and bytes per time bucket from each table's Delta history; status and runs from the Jobs and Pipelines APIs&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:80px&quot;&gt;Costs&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:178px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;/api/costs&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;LiveCosts&lt;/b&gt;: system.billing.usage × list_prices by product, SKU or resource&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:80px&quot;&gt;Data model&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:178px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;/api/model/status&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;information_schema.tables → which ERD tables exist (erd.json)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:80px&quot;&gt;Ask&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:178px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;/api/chat&lt;br&gt;/api/chat/conversations&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;Pydantic AI agent&lt;/b&gt; on the chat endpoint, tools describe_data, query_data (polars, no post text), make_chart; history in chat_messages&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:80px&quot;&gt;Control&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:178px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;/api/control&lt;br&gt;/api/control/{key}/{action}&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;LiveControl&lt;/b&gt;: pause topic map → enrich → ingest → silver; resume in the reverse order&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:80px&quot;&gt;Architecture&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:178px&quot;&gt;&lt;span style=&quot;color:light-dark(#52514e,#c3c2b7)&quot;&gt;static file&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left&quot;&gt;this diagram: &lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;diagrams/pipelines.drawio&lt;/span&gt; in the vendored draw.io viewer&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="srv-v24"><mxGeometry x="0" y="28" width="680" height="344" as="geometry"/></mxCell>
        <mxCell id="srv-v26" value="Frontend · frontend/public (no build step)" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=28;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#e8f0fb,#142238);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#2a78d6,#3987e5);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="680" y="574" width="680" height="70" as="geometry"/></mxCell>
        <mxCell id="srv-v27" value='&lt;span style="font-size:11.5px"&gt;index.html + &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;js/main.js&lt;/span&gt; tab router; one module per tab in &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;js/views&lt;/span&gt;; vendored Plotly, Chart.js and draw.io viewer; theme auto / light / dark.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="srv-v26"><mxGeometry x="0" y="28" width="680" height="42" as="geometry"/></mxCell>
        <mxCell id="srv-v28" value="Startup wiring · lifespan()" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=28;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#e8f0fb,#142238);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#2a78d6,#3987e5);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="680" y="660" width="680" height="120" as="geometry"/></mxCell>
        <mxCell id="srv-v29" value='&lt;span style="font-size:11.5px"&gt;&lt;b&gt;DATA_MODE = warehouse&lt;/b&gt; (a warehouse is bound through app.yaml): AutoSource(WarehouseSource, DemoSource), LiveGeo, LivePipelines, LiveCosts, LiveControl, DeltaChatStore.&lt;br&gt;&lt;b&gt;DATA_MODE = demo&lt;/b&gt; (no warehouse, e.g. local runs): DemoSource, DemoGeo, DemoPipelines, DemoCosts, DemoControl, SqliteChatStore. Every tab shows synthetic data and nothing touches the workspace.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="srv-v28"><mxGeometry x="0" y="28" width="680" height="92" as="geometry"/></mxCell>
        <mxCell id="srv-e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="srv-v23" target="srv-v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="srv-e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;startArrow=block;startFill=1;startSize=6;" edge="1" parent="1" source="srv-v24" target="srv-v26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="srv-e32" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);" edge="1" parent="1" target="srv-v18"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="205" as="sourcePoint"/><mxPoint x="385" y="205" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="srv-e33" value="rows" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.04;entryDx=0;entryDy=0;" edge="1" parent="1" source="srv-v18" target="srv-v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="srv-e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);dashed=1;dashPattern=5 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="srv-v19" target="srv-v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="srv-e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);dashed=1;dashPattern=5 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="srv-v20" target="srv-v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ops" name="Operations &amp; recovery">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ops-v1" value="&lt;b&gt;Operations and recovery&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=20;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="30" as="geometry"/></mxCell>
        <mxCell id="ops-v2" value='Shell scripts in &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px"&gt;bluesky/&lt;/span&gt; and &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px"&gt;app/scripts/&lt;/span&gt; use the Databricks CLI; settings live in &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px"&gt;bluesky/config.env&lt;/span&gt;. Each stage resumes from its own cursor.' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=13;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1360" height="22" as="geometry"/></mxCell>
        <mxCell id="ops-v3" value='&lt;b style="font-size:12px;letter-spacing:.06em"&gt;DEPLOY AND LIFECYCLE&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=12;spacing=6;rounded=1;arcSize=2;absoluteArcSize=1;fillColor=light-dark(#f6f5f2,#151514);strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="84" width="1360" height="336" as="geometry"/></mxCell>
        <mxCell id="ops-v4" value="config.env" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=28;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#f3f2ee,#262624);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#8a887f,#77766f);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="35" y="124" width="200" height="280" as="geometry"/></mxCell>
        <mxCell id="ops-v5" value="&lt;span style=&quot;font-size:11.5px&quot;&gt;workspace profile&lt;br&gt;catalog, schema, bronze table&lt;br&gt;job and pipeline names&lt;br&gt;Jetstream hosts, collections&lt;br&gt;flush and rewind seconds&lt;br&gt;PIPELINE_CONTINUOUS&lt;br&gt;ENRICH_* windows, caps, threshold&lt;br&gt;MAP_* schedule, window, label endpoint&lt;br&gt;TAXONOMY_* schedules, WIKI_CONTACT&lt;br&gt;&lt;br&gt;Sourced through &lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;lib.sh&lt;/span&gt; by every script, including the app's deploy.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="ops-v4"><mxGeometry x="0" y="28" width="200" height="252" as="geometry"/></mxCell>
        <mxCell id="ops-v6" value="setup.sh · deploy or restart" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=28;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#f8ece1,#2b2017);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a35f25,#d48d52);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="255" y="124" width="330" height="280" as="geometry"/></mxCell>
        <mxCell id="ops-v7" value='&lt;span style="font-size:11.5px"&gt;1. CREATE SCHEMA and events_raw on the SQL warehouse&lt;br&gt;2. upload &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;src/*.py&lt;/span&gt; to &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;/Workspace/Users/&amp;lt;you&amp;gt;/bluesky/src&lt;/span&gt;&lt;br&gt;3. create, or reset and restart, &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;bluesky-jetstream-ingest&lt;/span&gt;&lt;br&gt;4. create or update &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;bluesky-silver&lt;/span&gt;; stop if running; start an update&lt;br&gt;5. ENRICH_ENABLED: create or reset &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;bluesky-enrich&lt;/span&gt;&lt;br&gt;6. MAP_ENABLED: create or update &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;bluesky-topic-map&lt;/span&gt; (every 2 h)&lt;br&gt;7. TAXONOMY_ENABLED: the two taxonomy jobs (weekly)&lt;br&gt;&lt;br&gt;Re-runnable; a reset job restarts on the new code and resumes from its cursor. &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;taxonomy.sh&lt;/span&gt; deploys and runs only the taxonomy jobs.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="ops-v6"><mxGeometry x="0" y="28" width="330" height="252" as="geometry"/></mxCell>
        <mxCell id="ops-v8" value="stop.sh · pause" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=28;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#eef0f2,#212529);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#68717d,#a3acb6);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="605" y="124" width="250" height="132" as="geometry"/></mxCell>
        <mxCell id="ops-v9" value='&lt;span style="font-size:11.5px"&gt;pause the topic map and taxonomy schedules → pause enrich → pause ingest (cancel runs) → stop the pipeline. Data is kept.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="ops-v8"><mxGeometry x="0" y="28" width="250" height="104" as="geometry"/></mxCell>
        <mxCell id="ops-v10" value="status.sh · report" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=28;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#eef0f2,#212529);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#68717d,#a3acb6);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="605" y="272" width="250" height="132" as="geometry"/></mxCell>
        <mxCell id="ops-v11" value='&lt;span style="font-size:11.5px"&gt;trigger state and recent runs of every job; bronze events per collection in the last hour; posts enriched; current map size and age; taxonomy row counts&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="ops-v10"><mxGeometry x="0" y="28" width="250" height="104" as="geometry"/></mxCell>
        <mxCell id="ops-v12" value="teardown.sh · delete" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=28;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#f3f2ee,#262624);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#8a887f,#77766f);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="875" y="124" width="230" height="280" as="geometry"/></mxCell>
        <mxCell id="ops-v13" value='&lt;span style="font-size:11.5px"&gt;deletes the ingest, enrich, topic map and taxonomy jobs and the pipeline, which drops the silver tables it manages.&lt;br&gt;&lt;br&gt;Bronze, enrichment, map and taxonomy tables are kept.&lt;br&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;--drop-data&lt;/span&gt; also drops the schema and all data. Asks for confirmation unless &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;--yes&lt;/span&gt;.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="ops-v12"><mxGeometry x="0" y="28" width="230" height="252" as="geometry"/></mxCell>
        <mxCell id="ops-v14" value="app/scripts/deploy.sh" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=28;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#e8f0fb,#142238);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#2a78d6,#3987e5);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="1125" y="124" width="240" height="280" as="geometry"/></mxCell>
        <mxCell id="ops-v15" value='&lt;span style="font-size:11.5px"&gt;1. create app &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;bluesky-analytics&lt;/span&gt; with the &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;sql-warehouse&lt;/span&gt; resource&lt;br&gt;2. upload app.yaml, backend, frontend&lt;br&gt;3. grant its service principal USE CATALOG, USE SCHEMA, SELECT, write access for chat_messages; CAN_MANAGE on the ingest, enrich and topic map jobs, CAN_RUN on the pipeline&lt;br&gt;4. deploy&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="ops-v14"><mxGeometry x="0" y="28" width="240" height="252" as="geometry"/></mxCell>
        <mxCell id="ops-e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);dashed=1;dashPattern=5 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-v4" target="ops-v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ops-v17" value='&lt;b style="font-size:12px;letter-spacing:.06em"&gt;RESUME POINTS AND DELIVERY GUARANTEES&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=12;spacing=6;rounded=1;arcSize=2;absoluteArcSize=1;fillColor=light-dark(#f6f5f2,#151514);strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="1360" height="236" as="geometry"/></mxCell>
        <mxCell id="ops-v18" value="Ingest → events_raw" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=28;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#f8ece1,#2b2017);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a35f25,#d48d52);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="35" y="478" width="260" height="182" as="geometry"/></mxCell>
        <mxCell id="ops-v19" value='&lt;span style="font-size:11.5px"&gt;&lt;b&gt;Resumes from&lt;/b&gt; max(time_us) in events_raw − 10 s&lt;br&gt;&lt;b&gt;Delivery&lt;/b&gt; at-least-once, so bronze has duplicates&lt;br&gt;&lt;b&gt;Fails&lt;/b&gt; on 3 failed writes or 300 s without events; the trigger restarts it&lt;br&gt;&lt;b&gt;Limit&lt;/b&gt; Jetstream replays 36 h; a longer stop leaves a gap&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="ops-v18"><mxGeometry x="0" y="28" width="260" height="154" as="geometry"/></mxCell>
        <mxCell id="ops-v20" value="Silver pipeline" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=28;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#eef0f2,#212529);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#68717d,#a3acb6);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="305" y="478" width="260" height="182" as="geometry"/></mxCell>
        <mxCell id="ops-v21" value='&lt;span style="font-size:11.5px"&gt;&lt;b&gt;Resumes from&lt;/b&gt; Lakeflow streaming checkpoints&lt;br&gt;&lt;b&gt;Dedupes&lt;/b&gt; (did, rkey, rev) within a 15-minute watermark&lt;br&gt;&lt;b&gt;Orders&lt;/b&gt; by rev through AUTO CDC, so replays and late events are idempotent&lt;br&gt;&lt;b&gt;Deletes&lt;/b&gt; applied (SCD type 1)&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="ops-v20"><mxGeometry x="0" y="28" width="260" height="154" as="geometry"/></mxCell>
        <mxCell id="ops-v22" value="Enrich → gold" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=28;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#fbf2d6,#2a2410);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="575" y="478" width="260" height="182" as="geometry"/></mxCell>
        <mxCell id="ops-v23" value='&lt;span style="font-size:11.5px"&gt;&lt;b&gt;Resumes from&lt;/b&gt; max(time_us) in post_enriched, 60 s behind the bronze tail&lt;br&gt;&lt;b&gt;Writes&lt;/b&gt; post_enriched last; a crash re-runs the window and may duplicate sub-table rows&lt;br&gt;&lt;b&gt;Fails&lt;/b&gt; after 3 attempts at a window; the job restarts&lt;br&gt;&lt;b&gt;Not handled&lt;/b&gt; deletes after enrichment&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="ops-v22"><mxGeometry x="0" y="28" width="260" height="154" as="geometry"/></mxCell>
        <mxCell id="ops-v24" value="Topic map" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=28;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#fbf2d6,#2a2410);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="845" y="478" width="260" height="182" as="geometry"/></mxCell>
        <mxCell id="ops-v25" value='&lt;span style="font-size:11.5px"&gt;&lt;b&gt;No cursor&lt;/b&gt;: every run rebuilds from the last 24 h&lt;br&gt;&lt;b&gt;Too little data&lt;/b&gt; (under 200 posts): the old map stays&lt;br&gt;&lt;b&gt;LLM failure&lt;/b&gt;: names fall back to IPTC or hashtag labels&lt;br&gt;&lt;b&gt;Readers&lt;/b&gt; see one computed_at at a time&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="ops-v24"><mxGeometry x="0" y="28" width="260" height="154" as="geometry"/></mxCell>
        <mxCell id="ops-v26" value="Cost while running" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=6;swimlane;startSize=28;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#f3f2ee,#262624);swimlaneFillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#8a887f,#77766f);strokeWidth=1.5;dashed=0;fontStyle=1;align=left;spacingLeft=10;collapsible=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="1115" y="478" width="260" height="182" as="geometry"/></mxCell>
        <mxCell id="ops-v27" value='&lt;span style="font-size:11.5px"&gt;&lt;b&gt;Always on&lt;/b&gt;: ingest, silver, enrich, the app&lt;br&gt;&lt;b&gt;Scheduled&lt;/b&gt;: topic map every 2 h (UMAP, Haiku tokens), taxonomies weekly&lt;br&gt;&lt;b&gt;On demand&lt;/b&gt;: the SQL warehouse&lt;br&gt;&lt;b&gt;Variable&lt;/b&gt;: embeddings, at most 600 posts per 120 s window&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="ops-v26"><mxGeometry x="0" y="28" width="260" height="154" as="geometry"/></mxCell>
        <mxCell id="ops-v28" value="&lt;b&gt;Pause and resume order&lt;/b&gt; (stop.sh, setup.sh and the Control tab): downstream stops first, upstream starts first" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=13;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="696" width="1360" height="26" as="geometry"/></mxCell>
        <mxCell id="ops-v29" value="pause topic map" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=12;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=2;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="734" width="210" height="40" as="geometry"/></mxCell>
        <mxCell id="ops-v30" value="pause enrich job" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=12;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=2;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="270" y="734" width="210" height="40" as="geometry"/></mxCell>
        <mxCell id="ops-e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-v29" target="ops-v30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ops-v32" value="pause ingest job" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=12;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a35f25,#d48d52);strokeWidth=2;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="734" width="210" height="40" as="geometry"/></mxCell>
        <mxCell id="ops-e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-v30" target="ops-v32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ops-v34" value="stop silver pipeline" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=12;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#68717d,#a3acb6);strokeWidth=2;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="770" y="734" width="210" height="40" as="geometry"/></mxCell>
        <mxCell id="ops-e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-v32" target="ops-v34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ops-v36" value="resume ingest job" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=12;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a35f25,#d48d52);strokeWidth=2;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="790" width="210" height="40" as="geometry"/></mxCell>
        <mxCell id="ops-v37" value="start silver pipeline" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=12;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#68717d,#a3acb6);strokeWidth=2;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="270" y="790" width="210" height="40" as="geometry"/></mxCell>
        <mxCell id="ops-e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-v36" target="ops-v37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ops-v39" value="resume enrich job" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=12;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=2;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="790" width="210" height="40" as="geometry"/></mxCell>
        <mxCell id="ops-e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-v37" target="ops-v39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ops-v41" value="resume topic map" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=12;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=2;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="770" y="790" width="210" height="40" as="geometry"/></mxCell>
        <mxCell id="ops-e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-v39" target="ops-v41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ops-v43" value='&lt;span style="font-size:12px"&gt;stop.sh also pauses the taxonomy schedules. Resuming within 36 hours back-fills the gap from Jetstream; silver and enrich catch up from their own cursors; the map refreshes at its next scheduled run.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1020" y="734" width="360" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
