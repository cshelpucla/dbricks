  <diagram id="b2g" name="Bronze → Gold">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="1188" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="b2g-v1" value='&lt;b&gt;Bronze → Gold: &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:18px"&gt;enrich_job.py&lt;/span&gt; + &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:18px"&gt;enrich_lib.py&lt;/span&gt;&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=20;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="30" as="geometry"/></mxCell>
        <mxCell id="b2g-v2" value='Job &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px"&gt;bluesky-enrich&lt;/span&gt; (continuous, serverless) reads post-create events straight from bronze in 120 s windows, keyed on bronze &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px"&gt;time_us&lt;/span&gt;. Silver is not an input.' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=13;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1360" height="22" as="geometry"/></mxCell>
        <mxCell id="b2g-v3" value='&lt;b style="font-size:12px;letter-spacing:.06em"&gt;STARTUP · once per run&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=12;spacing=6;rounded=1;arcSize=2;absoluteArcSize=1;fillColor=light-dark(#f6f5f2,#151514);strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="84" width="1170" height="226" as="geometry"/></mxCell>
        <mxCell id="b2g-v4" value='&lt;b style="font-size:12px"&gt;GeoNames&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;cities15000, countryInfo, admin1&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;fillColor=light-dark(#f3f2ee,#262624);strokeColor=light-dark(#8a887f,#77766f);strokeWidth=1.25;align=center;" vertex="1" parent="1"><mxGeometry x="270" y="112" width="230" height="50" as="geometry"/></mxCell>
        <mxCell id="b2g-v5" value='&lt;b style="font-size:12px"&gt;IPTC Media Topics&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;JSON, all languages&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;fillColor=light-dark(#f3f2ee,#262624);strokeColor=light-dark(#8a887f,#77766f);strokeWidth=1.25;align=center;" vertex="1" parent="1"><mxGeometry x="530" y="112" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="b2g-v6" value='&lt;b&gt;ensure_tables&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;CREATE TABLE IF NOT EXISTS&lt;/span&gt; for the 5 gold tables, clustered by event_date' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="b2g-v7" value='&lt;b&gt;load_gazetteer&lt;/b&gt;&lt;br&gt;download → in-memory gazetteer&lt;br&gt;&lt;span style="color:light-dark(#52514e,#c3c2b7)"&gt;on failure: none; geo falls back to coordinates, flags, TLDs and language&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="270" y="190" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="b2g-v8" value='&lt;b&gt;load_taxonomy&lt;/b&gt;&lt;br&gt;first run: &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;parse_iptc&lt;/span&gt; (active concepts, parent, level, path), embed "label: definition", append&lt;br&gt;every run: embed 12 "no topic" anchors' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="530" y="190" width="250" height="100" as="geometry"/></mxCell>
