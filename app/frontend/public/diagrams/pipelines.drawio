        <mxCell id="ovw-v1" value="&lt;b&gt;Bluesky analytics: end-to-end architecture&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=20;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="30" as="geometry"/></mxCell>
        <mxCell id="ovw-v2" value='Live Bluesky events → Delta tables in Unity Catalog &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px"&gt;datawranglers.bluesky&lt;/span&gt; → Databricks App. All compute is serverless: ingest, silver and enrich run continuously, the topic map every 2 h, taxonomies weekly.' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=13;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1360" height="22" as="geometry"/></mxCell>
