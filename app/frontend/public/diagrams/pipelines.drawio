        <mxCell id="b2s-v31" value='&lt;table style="width:100%;border-collapse:collapse;font-size:11.5px"&gt;&lt;tr&gt;&lt;td style="padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:130px"&gt;&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;subject_did&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left"&gt;&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;record.subject&lt;/span&gt; &lt;span style="color:light-dark(#52514e,#c3c2b7)"&gt;(did follows subject_did)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left;width:130px"&gt;&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;created_at&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:3px 8px 3px 0;border-bottom:1px solid light-dark(#e1e0d9,#383835);vertical-align:top;text-align:left"&gt;&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;try_to_timestamp(record.createdAt)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="b2s-v30"><mxGeometry x="0" y="28" width="580" height="68" as="geometry"/></mxCell>
