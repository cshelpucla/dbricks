        <mxCell id="b2g-v59" value='&lt;b style="font-size:12px"&gt;taxonomy_people&lt;br&gt;taxonomy_companies&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;weekly, from Wikipedia + Wikidata&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=1.75;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="960" y="894" width="190" height="86" as="geometry"/></mxCell>
        <mxCell id="b2g-e60" value="re-read every 10 min" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);dashed=1;dashPattern=5 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2g-v59" target="b2g-v43"><mxGeometry relative="1" as="geometry" x="0"></mxGeometry></mxCell>
        <mxCell id="b2g-v61" value='&lt;span style="font-size:12px"&gt;&lt;b&gt;Gold tables&lt;/b&gt; · append&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#f7f6f3,#2a2a28);strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="945" y="1000" width="435" height="200" as="geometry"/></mxCell>
        <mxCell id="b2g-v62" value='&lt;b style="font-size:12px"&gt;① post_geo&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;post × place candidate&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#a87400,#e0a82e);strokeWidth=1.75;dashed=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="960" y="1033" width="195" height="66" as="geometry"/></mxCell>
