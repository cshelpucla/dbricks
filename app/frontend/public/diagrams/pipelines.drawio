        <mxCell id="ovw-v72" value="Delta table" style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11.5;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="324.0" y="906" width="170" height="24" as="geometry"/></mxCell>
        <mxCell id="ovw-v73" value="" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;fillColor=light-dark(#f3f2ee,#262624);strokeColor=light-dark(#8a887f,#77766f);strokeWidth=1.25;align=center;" vertex="1" parent="1"><mxGeometry x="418.2" y="906" width="44" height="24" as="geometry"/></mxCell>
        <mxCell id="ovw-v74" value="external or platform service" style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11.5;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470.2" y="906" width="170" height="24" as="geometry"/></mxCell>
        <mxCell id="ovw-v75" value="" style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=12;spacing=6;rounded=1;arcSize=12;fillColor=light-dark(#ffffff,#232321);strokeColor=#898781;strokeWidth=2;dashed=1;dashPattern=6 4;align=center;" vertex="1" parent="1"><mxGeometry x="669.8" y="906" width="44" height="24" as="geometry"/></mxCell>
        <mxCell id="ovw-v76" value="designed, not built" style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11.5;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="721.8" y="906" width="170" height="24" as="geometry"/></mxCell>
        <mxCell id="ovw-e77" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="865.5999999999999" y="918" as="sourcePoint"/><mxPoint x="909.5999999999999" y="918" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ovw-v78" value="data flow" style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11.5;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="917.5999999999999" y="906" width="190" height="24" as="geometry"/></mxCell>
        <mxCell id="ovw-e79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);dashed=1;dashPattern=5 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="999.3999999999999" y="918" as="sourcePoint"/><mxPoint x="1043.3999999999999" y="918" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ovw-v80" value="reference, control or lookup" style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11.5;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1051.3999999999999" y="906" width="190" height="24" as="geometry"/></mxCell>
        <mxCell id="ovw-e81" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#c93a39,#e66767);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#c93a39,#e66767);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);dashed=1;dashPattern=5 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1250.9999999999998" y="918" as="sourcePoint"/><mxPoint x="1294.9999999999998" y="918" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ovw-v82" value="failure path" style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11.5;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1302.9999999999998" y="906" width="190" height="24" as="geometry"/></mxCell>
        <mxCell id="ovw-v83" value='&lt;span style="font-size:12px"&gt;The app also reads bronze and silver (Pipelines tab: Delta table history) and writes Ask-tab history to &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;chat_messages&lt;/span&gt;. Tabs above walk through each stage in detail.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=12;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="940" width="1360" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="s2b" name="Source → Bronze">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s2b-v1" value='&lt;b&gt;Source → Bronze: &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:18px"&gt;jetstream_ingest.py&lt;/span&gt;&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=20;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="30" as="geometry"/></mxCell>
        <mxCell id="s2b-v2" value='Job &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px"&gt;bluesky-jetstream-ingest&lt;/span&gt; (continuous, serverless). Two threads share a bounded queue: one reads Jetstream, one writes Delta.' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=13;spacing=2;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1360" height="22" as="geometry"/></mxCell>
        <mxCell id="s2b-v3" value='&lt;b style="font-size:12px"&gt;jetstream.us-east&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;primary&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=12;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6250d6,#9085e9);strokeWidth=2;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="180" height="56" as="geometry"/></mxCell>
        <mxCell id="s2b-v4" value='&lt;b style="font-size:12px"&gt;jetstream.us-west&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;failover&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=12;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6250d6,#9085e9);strokeWidth=2;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="192" width="180" height="56" as="geometry"/></mxCell>
        <mxCell id="s2b-v5" value='&lt;span style="font-size:11px"&gt;&lt;b&gt;Endpoint&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;/xrpc/network.bsky.jetstream&lt;br&gt;.subscribeEvents&lt;/span&gt;&lt;br&gt;subprotocol &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;xrpc.v1.json&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Filter&lt;/b&gt;&lt;br&gt;post, like, repost, follow&lt;br&gt;&lt;br&gt;&lt;b&gt;Cursor&lt;/b&gt;&lt;br&gt;unix microseconds, not &lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;seq&lt;/span&gt; (seq differs per host)&lt;br&gt;&lt;br&gt;&lt;b&gt;Replay&lt;/b&gt; 36 h&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=6;absoluteArcSize=1;fillColor=light-dark(#f7f6f3,#2a2a28);strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="268" width="180" height="250" as="geometry"/></mxCell>
        <mxCell id="s2b-v6" value='&lt;b style="font-size:12px;letter-spacing:.06em"&gt;READER THREAD · JetstreamReader (daemon)&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#52514e,#c3c2b7);fontSize=12;spacing=6;rounded=1;arcSize=2;absoluteArcSize=1;fillColor=light-dark(#f6f5f2,#151514);strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="240" y="84" width="400" height="720" as="geometry"/></mxCell>
        <mxCell id="s2b-v7" value='&lt;b&gt;Build URL&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px"&gt;wss://{host}/…/subscribeEvents?collections=…&amp;amp;cursor=…&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="260" y="124" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="s2b-v8" value="&lt;b&gt;connect()&lt;/b&gt; · ping every 20 s, timeout 60 s, frames up to 4 MiB" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="260" y="204" width="360" height="50" as="geometry"/></mxCell>
        <mxCell id="s2b-v9" value="&lt;b&gt;for each frame&lt;/b&gt;: &lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;json.loads&lt;/span&gt; → payload; kind = &lt;span style=&quot;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px&quot;&gt;$type&lt;/span&gt; after '#'" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="260" y="274" width="360" height="50" as="geometry"/></mxCell>
        <mxCell id="s2b-v10" value="message and&lt;br&gt;kind ≠ info?" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=11;spacing=2;shape=rhombus;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="290" y="344" width="180" height="86" as="geometry"/></mxCell>
        <mxCell id="s2b-v11" value='log and skip&lt;br&gt;&lt;span style="font-size:11px"&gt;e.g. OutdatedCursor&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=center;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="490" y="357" width="125" height="60" as="geometry"/></mxCell>
        <mxCell id="s2b-v12" value="&lt;b&gt;queue.put&lt;/b&gt;((collection, frame))&lt;br&gt;last_time = payload.time" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="260" y="452" width="360" height="56" as="geometry"/></mxCell>
        <mxCell id="s2b-v13" value="&lt;b&gt;connection lost&lt;/b&gt; → failures += 1" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#c93a39,#e66767);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="260" y="548" width="360" height="44" as="geometry"/></mxCell>
        <mxCell id="s2b-v14" value="2 failures in a row and more than one host →&lt;br&gt;&lt;b&gt;fail over&lt;/b&gt; to the next host" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#c93a39,#e66767);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="260" y="612" width="360" height="50" as="geometry"/></mxCell>
        <mxCell id="s2b-v15" value="sleep min(60, 2&lt;sup&gt;failures&lt;/sup&gt;) s + jitter, then reconnect from&lt;br&gt;&lt;b&gt;cursor = last_time − 10 s&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontColor=light-dark(#0b0b0b,#f0efec);fontSize=12;spacing=6;rounded=1;arcSize=10;absoluteArcSize=1;fillColor=light-dark(#ffffff,#232321);strokeColor=light-dark(#c93a39,#e66767);strokeWidth=1.25;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="260" y="682" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="s2b-e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2b-v7" target="s2b-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s2b-e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2b-v8" target="s2b-v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s2b-e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2b-v9" target="s2b-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s2b-e19" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2b-v10" target="s2b-v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s2b-e20" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2b-v10" target="s2b-v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s2b-e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2b-v3" target="s2b-v8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="232" y="148"/><mxPoint x="232" y="219"/></Array></mxGeometry></mxCell>
        <mxCell id="s2b-e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#6b6a66,#a3a29a);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#52514e,#c3c2b7);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2b-v4" target="s2b-v8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="232" y="220"/><mxPoint x="232" y="219"/></Array></mxGeometry></mxCell>
        <mxCell id="s2b-e23" value="exception" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#c93a39,#e66767);strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontColor=light-dark(#c93a39,#e66767);fontSize=11;labelBackgroundColor=light-dark(#fcfcfb,#1a1a19);dashed=1;dashPattern=5 4;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2b-v8" target="s2b-v13"><mxGeometry relative="1" as="geometry" x="0.2"><Array as="points"><mxPoint x="250" y="244"/><mxPoint x="250" y="570"/></Array></mxGeometry></mxCell>
